<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET" />
  <application
      android:label="@string/app_name"
      android:icon="@mipmap/ic_glass"
      android:roundIcon="@mipmap/ic_glass"
      android:theme="@style/Suiji"
      android:supportsRtl="true"
      android:usesCleartextTraffic="${cleartext}">
    <activity
        android:name=".MainActivity"
        android:exported="false"
        android:launchMode="singleTask"
        android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
        android:windowSoftInputMode="adjustResize" />
    <!-- One launcher entry per style; the app enables the one matching the style picked in Settings. -->
    <activity-alias android:name=".Glass" android:targetActivity=".MainActivity" android:exported="true" android:enabled="true"
        android:icon="@mipmap/ic_glass" android:roundIcon="@mipmap/ic_glass">
      <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
    </activity-alias>
    <activity-alias android:name=".Paper" android:targetActivity=".MainActivity" android:exported="true" android:enabled="false"
        android:icon="@mipmap/ic_paper" android:roundIcon="@mipmap/ic_paper">
      <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
    </activity-alias>
    <activity-alias android:name=".Terminal" android:targetActivity=".MainActivity" android:exported="true" android:enabled="false"
        android:icon="@mipmap/ic_terminal" android:roundIcon="@mipmap/ic_terminal">
      <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
    </activity-alias>
    <activity-alias android:name=".Blocks" android:targetActivity=".MainActivity" android:exported="true" android:enabled="false"
        android:icon="@mipmap/ic_blocks" android:roundIcon="@mipmap/ic_blocks">
      <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
    </activity-alias>
  </application>
</manifest>
